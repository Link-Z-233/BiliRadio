// 签名配置模板（示例）：复制本文件为 build-profile.json5，填入你自己的签名材料后使用。
// 切勿将真实签名密码、证书路径提交到版本控制——本仓库不包含任何签名凭据。
// 本地调试：用 DevEco Studio 自动生成 debug 签名后可直接构建（hvigorfile.ts 保底自动补 product 引用）；
// 更符合隔离约定的做法是把材料移到 signing.local.json5（构建时注入，详见 SECURITY.md「签名与证书隔离」）。
{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "<YOUR_CERT_PATH>",
          "keyAlias": "<YOUR_KEY_ALIAS>",
          "keyPassword": "<YOUR_KEY_PASSWORD>",
          "profile": "<YOUR_PROFILE_PATH>",
          "signAlg": "SHA256withECDSA",
          "storeFile": "<YOUR_STORE_PATH>",
          "storePassword": "<YOUR_STORE_PASSWORD>"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}